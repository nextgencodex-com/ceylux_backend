PORT=4000

# CORS Configuration - Frontend URL that should access this API
# For local development: http://localhost:5173
# For production, replace with your deployed frontend URL (comma-separated if multiple)
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin SDK credentials
# Values obtained from your Firebase Service Account JSON
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: Keep the double quotes and literal \n characters for the private key string
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
